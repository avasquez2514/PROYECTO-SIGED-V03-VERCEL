# Copia este archivo a .env y completa los valores. En Vercel: Project → Settings → Environment Variables.

# Base de datos (Supabase → Connect → Transaction pooler, puerto 6543). Codifica caracteres especiales de la contraseña (+ → %2B).
DATABASE_URL=

# Secreto para firmar los JWT (usa 32+ caracteres aleatorios):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY=

# Supabase (Project Settings → API). La anon key es pública; protege tus tablas/buckets con RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
